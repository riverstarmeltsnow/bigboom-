.page {
  min-height: 100vh;
  background: #f5f7fa;
  padding-bottom: 40rpx;
}

.section {
  background: #fff;
  margin: 20rpx 30rpx;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
}

/* 城市搜索 */
.search-box {
  display: flex;
  align-items: center;
  background: #f5f7fa;
  border-radius: 12rpx;
  padding: 0 24rpx;
}

.search-input {
  flex: 1;
  height: 80rpx;
  font-size: 28rpx;
}

.search-clear {
  padding: 10rpx;
  color: #999;
  font-size: 28rpx;
}

.search-results {
  margin-top: 16rpx;
  max-height: 400rpx;
  overflow-y: auto;
}

.search-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.search-item:last-child {
  border-bottom: none;
}

.city-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
}

.city-adm {
  font-size: 24rpx;
  color: #999;
}

.search-empty {
  text-align: center;
  padding: 30rpx;
  color: #999;
  font-size: 26rpx;
}

/* 开关项 */
.switch-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.switch-item:last-child {
  border-bottom: none;
}

.switch-label {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
}

.switch-icon {
  font-size: 40rpx;
}

.switch-name {
  display: block;
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.switch-desc {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

/* 按钮项 */
.btn-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #333;
}

.btn-arrow {
  color: #ccc;
  font-size: 36rpx;
}

.footer {
  text-align: center;
  padding: 40rpx;
  font-size: 24rpx;
  color: #bbb;
}
