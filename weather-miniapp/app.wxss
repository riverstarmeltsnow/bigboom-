/* ====== 全局样式 ====== */
page {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC',
    'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
  -webkit-font-smoothing: antialiased;
}

/* 去除默认边距 */
view, text, image, input, button {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

/* 按钮重置 */
button {
  background: none;
  border: none;
  padding: 0;
  margin: 0;
  font-size: inherit;
  line-height: inherit;
}

button::after {
  border: none;
}
